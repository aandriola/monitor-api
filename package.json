{
  "name": "monitor-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "migrate": "node --env-file=.env node_modules/knex/bin/cli.js migrate:latest",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "knex": "^3.1.0",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^9.9.0",
    "vitest": "^2.0.5"
  }
}
